{
  "datasets": [
    {
      "name": "ds_health_status",
      "displayName": "Overall Health Status",
      "queryLines": [
        "WITH latest_perf AS (\n",
        "  SELECT auc FROM workspace.aade.mock_performance_history\n",
        "  ORDER BY week_start DESC LIMIT 1\n",
        "),\n",
        "latest_drift AS (\n",
        "  SELECT MAX(psi) AS max_psi FROM workspace.aade.mock_drift_history\n",
        "  WHERE week_start = (SELECT MAX(week_start) FROM workspace.aade.mock_drift_history)\n",
        "),\n",
        "open_alerts AS (\n",
        "  SELECT COUNT(*) AS open_count FROM workspace.aade.mock_alerts\n",
        "  WHERE status = 'open' AND severity = 'critical'\n",
        ")\n",
        "SELECT\n",
        "  ROUND((SELECT auc FROM latest_perf), 4)         AS current_auc,\n",
        "  ROUND((SELECT max_psi FROM latest_drift), 4)    AS max_drift_psi,\n",
        "  (SELECT open_count FROM open_alerts)            AS critical_alerts_open,\n",
        "  CASE\n",
        "    WHEN (SELECT open_count FROM open_alerts) > 0 THEN 'DEGRADED'\n",
        "    WHEN (SELECT max_psi FROM latest_drift) > 0.2 THEN 'WATCH'\n",
        "    WHEN (SELECT auc FROM latest_perf) < 0.8 THEN 'WATCH'\n",
        "    ELSE 'HEALTHY'\n",
        "  END                                              AS overall_status"
      ]
    },
    {
      "name": "ds_kpi_30d",
      "displayName": "30-day KPIs",
      "queryLines": [
        "SELECT\n",
        "  SUM(total_predictions)        AS predictions_30d,\n",
        "  SUM(high_risk_count)          AS high_risk_30d,\n",
        "  ROUND(AVG(high_risk_pct), 2)  AS avg_high_risk_pct_30d,\n",
        "  ROUND(AVG(avg_risk_score), 4) AS avg_risk_score_30d\n",
        "FROM workspace.aade.mock_predictions_timeseries\n",
        "WHERE date >= DATE_SUB(current_date(), 30)"
      ]
    },
    {
      "name": "ds_daily_volume",
      "displayName": "Daily Volume",
      "queryLines": [
        "SELECT date, total_predictions, high_risk_count, high_risk_pct, model_version\n",
        "FROM workspace.aade.mock_predictions_timeseries\n",
        "ORDER BY date"
      ]
    },
    {
      "name": "ds_drift_heatmap",
      "displayName": "Drift PSI Heatmap",
      "queryLines": [
        "SELECT week_start, feature, psi, severity\n",
        "FROM workspace.aade.mock_drift_history\n",
        "ORDER BY week_start, feature"
      ]
    },
    {
      "name": "ds_performance",
      "displayName": "Model Performance",
      "queryLines": [
        "SELECT week_start, auc, precision, recall, f1_score, model_version\n",
        "FROM workspace.aade.mock_performance_history\n",
        "ORDER BY week_start"
      ]
    },
    {
      "name": "ds_latency",
      "displayName": "Endpoint Latency",
      "queryLines": [
        "SELECT ts, latency_p50_ms, latency_p95_ms, latency_p99_ms, error_rate_pct, rps\n",
        "FROM workspace.aade.mock_endpoint_metrics\n",
        "WHERE ts >= current_timestamp() - INTERVAL 24 HOURS\n",
        "ORDER BY ts"
      ]
    },
    {
      "name": "ds_alerts",
      "displayName": "Active Alerts",
      "queryLines": [
        "SELECT alert_id, fired_at, severity, metric, value, threshold, status, owner, incident_id\n",
        "FROM workspace.aade.mock_alerts\n",
        "WHERE status IN ('open', 'acknowledged')\n",
        "ORDER BY\n",
        "  CASE severity WHEN 'critical' THEN 1 WHEN 'warning' THEN 2 ELSE 3 END,\n",
        "  fired_at DESC"
      ]
    }
  ],

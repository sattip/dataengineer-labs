                  {"fieldName": "job_name",         "displayName": "Job", "type": "string"},
                  {"fieldName": "owner",            "displayName": "Owner", "type": "string"},
                  {"fieldName": "total_runs",       "displayName": "Runs (7d)", "type": "integer"},
                  {"fieldName": "successes",        "displayName": "OK", "type": "integer"},

{
  "datasets": [
    {
      "name": "ds_active_jobs",
      "displayName": "Active Jobs",
      "queryLines": [
        "SELECT COUNT(*) AS active_jobs FROM system.lakeflow.jobs WHERE delete_time IS NULL"
      ]
    },
    {
      "name": "ds_runs_7d",
      "displayName": "Total Runs 7d",
      "queryLines": [
        "SELECT COUNT(*) AS total_runs FROM system.lakeflow.job_run_timeline ",
        "WHERE period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "AND period_end_time IS NOT NULL"
      ]
    },
    {
      "name": "ds_success_rate",
      "displayName": "Success Rate KPIs",
      "queryLines": [
        "SELECT ",
        "  COUNT(*) AS total_runs, ",
        "  SUM(CASE WHEN result_state='SUCCEEDED' THEN 1 ELSE 0 END) AS successful, ",
        "  SUM(CASE WHEN result_state='FAILED' THEN 1 ELSE 0 END) AS failed, ",
        "  ROUND(100.0*SUM(CASE WHEN result_state='SUCCEEDED' THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0), 2) AS success_rate_pct ",
        "FROM system.lakeflow.job_run_timeline ",
        "WHERE period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "AND period_end_time IS NOT NULL"
      ]
    },
    {
      "name": "ds_daily_trend",
      "displayName": "Daily Success Trend",
      "queryLines": [
        "SELECT ",
        "  date(period_start_time) AS run_date, ",
        "  COUNT(*) AS total_runs, ",
        "  SUM(CASE WHEN result_state='SUCCEEDED' THEN 1 ELSE 0 END) AS succeeded, ",
        "  SUM(CASE WHEN result_state='FAILED' THEN 1 ELSE 0 END) AS failed, ",
        "  ROUND(100.0*SUM(CASE WHEN result_state='SUCCEEDED' THEN 1 ELSE 0 END)/NULLIF(COUNT(*),0), 2) AS success_rate_pct ",
        "FROM system.lakeflow.job_run_timeline ",
        "WHERE period_start_time >= current_timestamp() - INTERVAL 30 DAYS ",
        "AND period_end_time IS NOT NULL ",
        "GROUP BY date(period_start_time) ORDER BY run_date"
      ]
    },
    {
      "name": "ds_health_table",
      "displayName": "Per-Job Health (filterable)",
      "queryLines": [
        "WITH stats AS ( ",
        "  SELECT j.job_id, j.name, j.creator_user_name, ",
        "    COUNT(rt.run_id) AS total_runs, ",
        "    SUM(CASE WHEN rt.result_state='SUCCEEDED' THEN 1 ELSE 0 END) AS successes, ",
        "    SUM(CASE WHEN rt.result_state='FAILED' THEN 1 ELSE 0 END) AS failures, ",
        "    MAX(rt.period_start_time) AS last_run_at, ",
        "    ROUND(AVG(rt.run_duration_seconds)/60.0, 2) AS avg_duration_min ",
        "  FROM system.lakeflow.jobs j ",
        "  LEFT JOIN system.lakeflow.job_run_timeline rt ",
        "    ON j.job_id=rt.job_id AND rt.period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "  WHERE j.delete_time IS NULL ",
        "  GROUP BY j.job_id, j.name, j.creator_user_name) ",
        "SELECT job_id, name AS job_name, creator_user_name AS owner, total_runs, successes, failures, ",
        "  ROUND(100.0*successes/NULLIF(total_runs,0), 2) AS success_pct, ",
        "  last_run_at, avg_duration_min, ",
        "  CASE WHEN total_runs=0 THEN 'NO RUNS' ",
        "       WHEN failures/NULLIF(total_runs,0) > 0.2 THEN 'DEGRADED' ",
        "       WHEN failures > 0 THEN 'WATCH' ",
        "       ELSE 'HEALTHY' END AS health ",
        "FROM stats ORDER BY failures DESC, total_runs DESC"
      ]
    },
    {
      "name": "ds_all_runs",
      "displayName": "All Recent Runs (filterable by job)",
      "queryLines": [
        "SELECT ",
        "  j.name AS job_name, ",
        "  rt.job_id, ",
        "  rt.run_id, ",
        "  rt.period_start_time AS started_at, ",
        "  ROUND(rt.run_duration_seconds/60.0, 2) AS duration_min, ",
        "  rt.result_state AS status, ",
        "  rt.termination_code AS error_code, ",
        "  rt.trigger_type, ",
        "  CONCAT('https://', current_metastore(), '/?#job/', rt.job_id, '/run/', rt.run_id) AS run_url ",
        "FROM system.lakeflow.job_run_timeline rt ",
        "JOIN system.lakeflow.jobs j ON rt.job_id=j.job_id ",
        "WHERE rt.period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "AND rt.period_end_time IS NOT NULL ",
        "ORDER BY rt.period_start_time DESC LIMIT 500"
      ]
    },
    {
      "name": "ds_task_drill",
      "displayName": "Task-level Drill-Down (filterable by job)",
      "queryLines": [
        "SELECT ",
        "  j.name AS job_name, ",
        "  tr.run_id, ",
        "  tr.task_key, ",
        "  tr.period_start_time AS started_at, ",
        "  ROUND(tr.run_duration_seconds/60.0, 2) AS duration_min, ",
        "  tr.result_state AS status, ",
        "  tr.termination_code AS error_code, ",
        "  tr.attempt_number ",
        "FROM system.lakeflow.job_task_run_timeline tr ",
        "JOIN system.lakeflow.jobs j ON tr.job_id=j.job_id ",
        "WHERE tr.period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "AND tr.period_end_time IS NOT NULL ",
        "ORDER BY tr.period_start_time DESC LIMIT 500"
      ]
    },
    {
      "name": "ds_dlt_health",
      "displayName": "DLT Pipelines Health",
      "queryLines": [
        "SELECT p.name AS pipeline_name, ",
        "  COUNT(pr.update_id) AS total_updates_7d, ",
        "  SUM(CASE WHEN pr.result_state='COMPLETED' THEN 1 ELSE 0 END) AS succeeded, ",
        "  SUM(CASE WHEN pr.result_state='FAILED' THEN 1 ELSE 0 END) AS failed, ",
        "  MAX(pr.period_start_time) AS last_update_at ",
        "FROM system.lakeflow.pipelines p ",
        "LEFT JOIN system.lakeflow.pipeline_update_timeline pr ON p.pipeline_id=pr.pipeline_id ",
        "  AND pr.period_start_time >= current_timestamp() - INTERVAL 7 DAYS ",
        "WHERE p.deleted_time IS NULL ",
        "GROUP BY p.pipeline_id, p.name ORDER BY failed DESC, total_updates_7d DESC"
      ]
    }
  ],
  "pages": [
